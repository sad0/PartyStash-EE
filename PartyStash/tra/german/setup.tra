@1 = ~Party Stash: eine unendliche Truhe für die ganze Gruppe (benötigt EEex)~
@2 = ~Benötigt EEex.~
@3 = ~Stash~
@4 = ~Die gemeinsame Truhe der ganzen Gruppe, auf der Inventarseite. Klickt auf einen Gegenstand, um ihn zu nehmen; Umschalt + Doppelklick auf einen Rucksackgegenstand oder Leertaste (Alles einl.) zum Einlagern; Strg + Klick markiert einen Gegenstand zum Verkauf über die Händler-Schaltfläche „Markierte verk.“. Ein in die Truhe gelegter Beutel wird in sie geleert und im Reiter Beutel behalten: Truhengegenstände, die er aufnehmen kann, wiegen nichts. Der Rest zählt zur Summe der Traglasten der Mitglieder; darüber werden alle verlangsamt.~
@5 = ~Sortierte Beute: am Boden, in Behältern und in der Beuteleiste~
@6 = ~Aussehen von Baldur's Gate 1 (empfohlen)~
@7 = ~Aussehen von Baldur's Gate II (empfohlen)~
@8 = ~Party Stash: Leert vor der Deinstallation die Truhe im Spiel: Strg + Linksklick auf den großen Beutel neben dem Gewicht auf der Inventarseite. Eure gesammelten Beutel kommen gefüllt mit den Gegenständen zurück, die sie aufnehmen können; alles andere fällt auf den Boden. Sonst bleibt der Truheninhalt in euren Spielständen, ist aber bis zur Neuinstallation des Mods unerreichbar.~
@9 = ~Aussehen von Baldur's Gate 1~
@10 = ~Aussehen von Baldur's Gate II~
@11 = ~Party Stash: eine unendliche Truhe für die ganze Gruppe (benötigt EEex)~
