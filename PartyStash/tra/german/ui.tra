@130 = ~Gewicht von Gruppe + Truhe / Summe der Traglasten der Mitglieder. Darüber werden alle verlangsamt. Truhengegenstände, die ein gesammelter Beutel aufnimmt (Reiter Beutel), wiegen nichts.~ // weight_tip
@131 = ~Beutel: Umschalt + Doppelklick oder Alles einl.~ // msg_bag_hint
@132 = ~Questgegenstände und Beutel bleiben im Rucksack~ // msg_quest_bags
@133 = ~Questgegenstände bleiben im Rucksack~ // msg_quest
@134 = ~Die Hand konnte nicht geleert werden~ // msg_hand
@135 = ~Beutel bleiben in der Sammlung~ // msg_bags_kept
@136 = ~Beutelinhalt: ~ // msg_bag_contents
@137 = ~Truhe wiederherstellen: Platz in einem Rucksack schaffen~ // msg_restore
@138 = ~Achtung: Eure Beutel werden in die Truhe geleert, und die passenden Gegenstände wiegen 0.~ // bags_warning
