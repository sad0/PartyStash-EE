@166 = ~Осн.~ // ab_main_hand
@167 = ~Друга~ // ab_off_hand
@168 = ~2 зброї~ // ab_two_weapon
@169 = ~Спорожнити скриню? Зібрані торби повернуться заповненими предметами, які вони вміщають; усе інше впаде на землю. Зробіть це перед видаленням Party Stash.~ // empty_confirm
@170 = ~Ctrl + лівий клік: розкласти скриню по торбах і на землю (перед видаленням)~ // bag_tip
@171 = ~Це ваша скриня~ // help_stash_title
@172 = ~Клік: узяти предмет (подвійний: узяти й одягнути)\nCtrl + клік: позначити для продажу («Продати позн.» у торговця)\nПравий клік: опис. Коліщатко миші: прокрутка~ // help_stash
@173 = ~Це спорядження вашого персонажа~ // help_pack_title
@174 = ~Shift + подвійний клік або перетягування на скриню: прибрати предмет\nПробіл або «Прибрати все»: прибрати весь наплічник~ // help_pack
@175 = ~Пробіл: прибрати весь наплічник.\nКвестові предмети лишаються в наплічнику; торби просять підтвердження.~ // help_storeall
@176 = ~Клацніть, щоб змінити сортування.\nАвто: кожна вкладка має свій порядок (зброя й броня за якістю, сувої за класом і рівнем...).\nТакож: Дата, Якість, Тип, Ціна, Ціна/вага.~ // help_sort
@177 = ~Приберіть торбу (Shift + подвійний клік або «Прибрати все»): її буде висипано у скриню й залишено тут.\nПредмети скрині, які вона вміщає, нічого не важать.~ // help_bags
@178 = ~Буде продано позначених предметів: %d, за %d зм.\nПропущено позначених: %d (без ціни, квестові або тут не купують).~ // help_sell
@179 = ~Скриня загону: гра вважає її предмети носимими (квести).~ // stash_slot_tip
