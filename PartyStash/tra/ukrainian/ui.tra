@130 = ~Вага загону + скрині / сума вантажопідйомності членів. Понад неї всі сповільнені. Предмети в скрині, які вміщаються в зібрану торбу (вкладка Торби), нічого не важать.~ // weight_tip
@131 = ~Торба: Shift + подвійний клік або «Прибрати все»~ // msg_bag_hint
@132 = ~Квестові предмети й торби лишаються в наплічнику~ // msg_quest_bags
@133 = ~Квестові предмети лишаються в наплічнику~ // msg_quest
@134 = ~Не вдалося звільнити руку~ // msg_hand
@135 = ~Торби лишаються в колекції~ // msg_bags_kept
@136 = ~Вміст торби: ~ // msg_bag_contents
@137 = ~Відновлення скрині: звільніть місце в наплічнику~ // msg_restore
@138 = ~Увага: ваші торби буде висипано у скриню, а відповідні предмети важитимуть 0.~ // bags_warning
@139 = ~Гаразд~ // bags_ok
