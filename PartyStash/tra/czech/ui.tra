@163 = ~Střely~ // ab_missile
@164 = ~Dov.~ // ab_prof
@165 = ~Základní THAC0~ // ab_base_thac0
@166 = ~Hlavní~ // ab_main_hand
@167 = ~Druhá~ // ab_off_hand
@168 = ~2 zbraně~ // ab_two_weapon
@169 = ~Vyprázdnit truhlu? Sebrané vaky se vrátí naplněné předměty, které pojmou; vše ostatní spadne na zem. Udělejte to před odinstalováním Party Stash.~ // empty_confirm
@170 = ~Ctrl + levé kliknutí: vysypat truhlu do vaků a na zem (před odinstalováním)~ // bag_tip
@171 = ~Toto je vaše truhla~ // help_stash_title
@172 = ~Kliknutí: vzít předmět (dvojklik: vzít a nasadit)\nCtrl + kliknutí: označit k prodeji (Prodat označené u obchodníka)\nPravé kliknutí: popis. Kolečko myši: posun\nKarty: filtrování truhly podle kategorie (kolečko nebo šipky pro zobrazení všech)~ // help_stash
@173 = ~Toto je inventář vaší postavy~ // help_pack_title
@174 = ~Shift + dvojklik nebo přetažení na truhlu: uložit předmět\nMezerník nebo Uložit vše: uložit celý batoh\nTruhla v posledním místě: vaše truhla; hra počítá její předměty jako nesené (úkoly).~ // help_pack
@175 = ~Mezerník: uložit celý batoh.\nÚkolové předměty zůstávají v batohu; vaky se ptají na potvrzení.~ // help_storeall
@176 = ~Kliknutím změníte řazení.\nAuto: každá karta má vlastní pořadí (zbraně a zbroje podle kvality, svitky podle povolání a úrovně...).\nDále: Datum, Kvalita, Typ, Cena, Cena/váha.~ // help_sort
@177 = ~Uložte vak (Shift + dvojklik nebo Uložit vše): vysype se do truhly a zůstane tady.\nPředměty v truhle, které pojme, nic neváží.~ // help_bags
@178 = ~Prodá se označených předmětů: %d, za %d zl.\nPřeskočeno označených: %d (bez ceny, úkolové nebo je zde nevykupují).~ // help_sell
@179 = ~Truhla družiny: hra počítá její předměty jako nesené (úkoly).~ // stash_slot_tip
