menu
{
	name "PSTASH_TICK"
	ignoreesc
	-- Its enabled check runs every frame: overflow, bag unlocks, shared weight.
	label
	{
		area 0 0 0 0
		enabled "PStash_Tick()"
	}
}

menu
{
	name 'INVENTORY'
	align center center
	ignoreEsc
	size 1120 710
	onOpen
	"
		Infinity_ActivateInventory()
		pushSidebars()
		doubleClickEventScheduled = nil

		for i = 1, Infinity_GetMaxGroundPage()+1 do
			fakeItemList[i] = 1
		end
		currentFakePage = Infinity_GetCurrentGroundPage()
		currentMaxFakePages = Infinity_GetMaxGroundPage()
		PStash_OnInventoryOpen()
	"
	onClose
	"
		Infinity_PopMenu('CHARACTER_COLOR')
		Infinity_PopMenu('ITEM_DESCRIPTION')
		Infinity_PopMenu('ITEM_IDENTIFY')
		popSidebars()

		fakeItemList = {}
		PStash_OnInventoryClose()
	"
	label
	{
		area 0 0 1120 710
		mosaic INVPSTSH
	}
	button
	{
		area 299 177 128 160
		paperdoll 1
		actiondrag "Infinity_SwapWithAppearance()"
	}
